    { "id": "concept:AI安全根本原则", "type": "concept", "name": "AI安全根本原则", "level": "道", "domain": "AI安全", "summary": "一切 AI 安全工作的公理起点：把机密性、完整性、可用性从静态系统扩展到会主动行动的智能体。核心推论是信任不可继承——模型能力越强，被滥用的后果越大，约束必须施加在架构层而非提示层。", "degree": 627 },
    { "id": "concept:身份安全", "type": "concept", "name": "身份安全", "level": "道", "domain": "身份安全", "summary": "数字世界的第一性问题：证明你是谁。口令、密钥、MFA 都只是身份的载体而非本质，攻击者拿到合法凭据即等于拿到这个人。因此身份是新边界，一切访问控制都从身份验证展开。", "degree": 398 },
    { "id": "concept:企业安全", "type": "concept", "name": "企业安全", "level": "道", "domain": "企业安全", "summary": "组织以体系而非单点对抗风险：网络、端点、身份、数据、合规五线协同。第一性认识是企业安全保护的不是机器，而是业务连续性与客户信任这两项无形资产。", "degree": 339 },
    { "id": "concept:供应链信任传递", "type": "concept", "name": "供应链信任传递", "level": "道", "domain": "供应链安全", "summary": "信任天然沿依赖链单向传递且不可逆：你信任的每个上游（软件包、模型、插件、固件）都在替你做安全决策。任一环节被污染，攻击便借助合法分发渠道直达下游——这是一切供应链攻击的共同原理。", "degree": 77 },
    { "id": "concept:数据隐私", "type": "concept", "name": "数据隐私", "level": "道", "domain": "数据安全", "summary": "个人信息自决权在数字系统的落地：数据主体应能控制信息的收集、使用与流转。AI 时代的新张力在于训练数据、推理上下文与企业数据外发，使隐私从存储问题变为流动问题。", "degree": 603 },

    { "id": "concept:AI安全研究", "type": "concept", "name": "AI安全研究", "level": "法", "domain": "AI安全", "summary": "对 AI 系统安全性的系统化研究方法：攻击面分析、威胁建模、防御机制、风险评估四步闭环。它把 AI 出事从孤立的个案追认为可复现、可度量的科学问题。", "degree": 609 },
    { "id": "concept:大语言模型安全", "type": "concept", "name": "大语言模型安全", "level": "法", "domain": "AI安全", "summary": "以 LLM 为对象的安全方法论。根本困难在于模型无法在架构层区分指令与数据，一切输入皆可成为攻击面；覆盖提示注入、越狱、数据泄露、生成代码缺陷等方向。", "degree": 476 },
    { "id": "concept:AI模型安全", "type": "concept", "name": "AI模型安全", "level": "法", "domain": "AI安全", "summary": "保障模型本身（权重与推理过程）免受对抗攻击、投毒、窃取与滥用的防护体系。模型是新的关键资产：被投毒的模型等于内建后门，被窃取的模型等于知识产权流失。", "degree": 340 },
    { "id": "concept:AI红队测试", "type": "concept", "name": "AI红队测试", "level": "法", "domain": "AI安全", "summary": "以攻击者视角对 AI 系统做系统性安全评估的方法论。与自动化扫描的根本区别：依赖人类专家的创造性发现测试用例覆盖不到的失败模式。红队是安全体系的对抗性检验器。", "degree": 469 },
    { "id": "concept:AI供应链安全", "type": "concept", "name": "AI供应链安全", "level": "法", "domain": "供应链安全", "summary": "把软件供应链方法论扩展到 AI 技术栈：第三方组件、预训练模型、数据集、依赖库、扩展协议均视为信任输入。模型投毒、后门、恶意插件都是供应链信任传递原理在 AI 栈上的投影。", "degree": 349 },
    { "id": "concept:软件供应链安全", "type": "concept", "name": "软件供应链安全", "level": "法", "domain": "供应链安全", "summary": "管理代码从开发到交付全链路信任的方法论：依赖治理、制品签名、构建管道防护。开源与 CI/CD 让引入他人代码成为默认动作，供应链安全因此从可选项变为必选项。", "degree": 171 },
    { "id": "concept:ITDR", "type": "concept", "name": "ITDR", "level": "法", "domain": "身份安全", "summary": "身份威胁检测与响应。核心假设是攻击者终将拿到合法凭据，因此要在身份平面持续监控异常：横向移动、权限变更、MFA 疲劳。它是身份即新边界这一原则的运营化落地。", "degree": 8 },
    { "id": "concept:终端安全", "type": "concept", "name": "终端安全", "level": "法", "domain": "终端安全", "summary": "保护工作站、服务器、移动设备等计算末端的防护体系：EDR、应用白名单、权限管控。终端是人与数字世界的接口，也是绝大多数攻击链的最终落点。", "degree": 18 },

    { "id": "concept:提示注入", "type": "concept", "name": "提示注入", "level": "术", "domain": "AI安全", "summary": "在提示词或外部内容中嵌入恶意指令以操纵 LLM 行为的攻击技术，分直接注入与间接注入（经网页、文档、工具结果进入）。根本成因是 LLM 架构上无法区分指令与数据——AI 时代的注入类问题原型。", "degree": 1084 },
    { "id": "concept:沙箱逃逸", "type": "concept", "name": "沙箱逃逸", "level": "术", "domain": "AI安全", "summary": "受隔离进程突破沙箱约束、获得宿主权限的攻击技术。突破点或在隔离机制本身（命名空间、系统调用过滤），或在宿主实现缺陷。沙箱是纵深防御的一环，而非可靠的安全边界。", "degree": 167 },
    { "id": "concept:供应链攻击", "type": "concept", "name": "供应链攻击", "level": "术", "domain": "供应链安全", "summary": "污染上游分发环节、使攻击随合法更新直达下游的攻击手法：投毒开源包、劫持构建管道、植入恶意更新。其威力来自信任本身——受害者会主动安装攻击。", "degree": 808 },
    { "id": "concept:文件上传漏洞", "type": "concept", "name": "文件上传漏洞", "level": "术", "domain": "漏洞研究", "summary": "利用应用上传功能植入恶意文件（WebShell、脚本）获取执行权的攻击面。AI Agent 时代风险放大：上传的文档既是知识输入，也是间接提示注入与恶意载荷的载体。", "degree": 364 },
    { "id": "concept:SQL注入", "type": "concept", "name": "SQL注入", "level": "术", "domain": "漏洞研究", "summary": "将恶意 SQL 经输入拼入查询的攻击技术，可致拖库、绕过认证、接管数据库。AI 生成代码引入新变体：助手补全的代码可能带着注入缺陷直接上线。", "degree": 760 },
    { "id": "concept:零日漏洞利用", "type": "concept", "name": "零日漏洞利用", "level": "术", "domain": "漏洞研究", "summary": "利用厂商尚未发现或未修复的漏洞发起攻击，在补丁空窗期成功率最高。防御无法依赖特征库，只能靠纵深防御与行为异常检测兜底。", "degree": 178 },
    { "id": "concept:本地权限提升", "type": "concept", "name": "本地权限提升", "level": "术", "domain": "漏洞研究", "summary": "在已立足的机器上从普通用户提权至 root/SYSTEM 的技术，常借助内核漏洞或错误配置。它是攻击链从进门到控制的关键一跳。", "degree": 73 },
    { "id": "concept:Linux内核漏洞", "type": "concept", "name": "Linux内核漏洞", "level": "术", "domain": "漏洞研究", "summary": "Linux 内核中的缺陷，可致权限提升、容器逃逸或拒绝服务。内核是所有 Linux 服务器与云基础设施的信任基点，单个内核漏洞的影响面因此极大。", "degree": 194 },

    { "id": "concept:MCP", "type": "concept", "name": "MCP", "level": "器", "domain": "AI安全", "summary": "Model Context Protocol，Anthropic 提出的开放协议，标准化 AI 应用与外部工具、数据的连接。它让 Agent 能力可插拔扩展，也让工具结果成为不可信输入的新入口——扩展层即攻击面。", "degree": 265 },
    { "id": "concept:RAG", "type": "concept", "name": "RAG", "level": "器", "domain": "AI安全", "summary": "检索增强生成：先检索外部知识库再生成回答的架构。安全意义双面：一方面缓解幻觉，另一方面把知识库变成投毒目标——检索内容会被模型当作指令执行。", "degree": 142 },
    { "id": "concept:CI/CD", "type": "concept", "name": "CI/CD", "level": "器", "domain": "供应链安全", "summary": "持续集成与持续交付管道：代码到制品的自动化交付通道。安全双重性在于：管道既能自动执行安全检查，也把谁能触发构建、谁能打 tag 变成发布权的实质。", "degree": 44 },
    { "id": "concept:CVE-2026-82533", "type": "concept", "name": "CVE-2026-82533", "level": "器", "domain": "漏洞研究", "summary": "DeepSeek Harness 编码智能体框架的认证缺失漏洞，CVSS 9.4。本地服务无认证暴露 API，沙箱内 Agent 的指令可直达宿主——沙箱有墙、门没上锁的典型案例。", "degree": 4 }
  ],
